PORT=5000

# --- Option 1: Gmail SMTP (Fallback) ---
# If using Gmail, you only need these two. Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop

# --- Option 2: Brevo SMTP (Recommended for Render) ---
# If these are set, they will override the Gmail SMTP settings.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASS=your-brevo-smtp-key
# The sender email verified in your Brevo account (required by Brevo)
EMAIL_FROM=your-verified-brevo-sender@example.com
# The inbox where you want to receive the contact form submissions (defaults to EMAIL_USER or SMTP_USER if not set)
EMAIL_TO=your-receiving-inbox@example.com
